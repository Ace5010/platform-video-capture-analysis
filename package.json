{
  "name": "douyin-competitor-monitor",
  "version": "0.9.7",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "dev:web": "vinext dev",
    "setup:asr": "powershell -ExecutionPolicy Bypass -File scripts/setup-asr.ps1",
    "test:bridge": "node scripts/test-dashboard-bridge.mjs",
    "test:connector": "node scripts/test-extension-connector.mjs",
    "test:asr": ".venv\\Scripts\\python.exe scripts/test-local-asr.py",
    "test:host": ".venv\\Scripts\\python.exe scripts/test-host-service.py && .venv\\Scripts\\python.exe scripts/test-cloud-asr.py && .venv\\Scripts\\python.exe scripts/test-qwen-upload.py && .venv\\Scripts\\python.exe scripts/test-analysis-reuse.py",
    "test:scheduler": "node scripts/test-extension-scheduler.mjs",
    "test:extension-compatibility": "node --experimental-strip-types scripts/test-extension-compatibility.ts",
    "test:video-analytics": "node --experimental-strip-types scripts/test-video-analytics.ts",
    "test:content-browse": "node --experimental-strip-types scripts/test-content-browse.ts",
    "test:analysis-usage": "node --experimental-strip-types scripts/test-analysis-usage.ts",
    "test:reading": "node --experimental-strip-types scripts/test-remotion-plan.ts && node --experimental-strip-types scripts/test-analysis-diagnostics.ts",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test:browser": "node scripts/test-browser-worker.mjs && node scripts/test-partial-capture.mjs && .venv\\Scripts\\python.exe scripts/test-browser-host.py"
  },
  "dependencies": {
    "next": "16.2.6",
    "playwright-core": "^1.63.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
