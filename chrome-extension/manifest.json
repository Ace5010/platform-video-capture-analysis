{
  "manifest_version": 3,
  "name": "抖音监控账号 - 本地采集组件",
  "version": "0.7.0",
  "minimum_chrome_version": "110",
  "description": "连接本机任务队列与当前 Chrome 登录状态，采集公开抖音账号数据及完整视频媒体流。",
  "permissions": ["alarms", "scripting", "storage", "tabs", "webRequest", "unlimitedStorage"],
  "host_permissions": [
    "https://www.douyin.com/*",
    "https://*.douyinvod.com/*",
    "https://*.douyinstatic.com/*",
    "https://*.douyinpic.com/*",
    "https://*.zjcdn.com/*",
    "https://*.bytecdn.cn/*",
    "https://*.byteimg.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.douyin.com/user/*"],
      "js": ["douyin-response-capture.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "抖音监控账号"
  }
}
